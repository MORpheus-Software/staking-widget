# MOR Staking Widget Environment Configuration
# ------------------------------------------------

# App Settings
VITE_APP_NAME=MOR Staking Widget
VITE_APP_VERSION=1.0.0

# Network Configuration
# ------------------------------------------------
# Mainnet RPC (Arbitrum One)
VITE_MAINNET_RPC_URL=https://arb1.arbitrum.io/rpc
VITE_MAINNET_CHAIN_ID=0xa4b1

# Testnet RPC (Arbitrum Sepolia)
VITE_TESTNET_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
VITE_TESTNET_CHAIN_ID=0x66eee

# Contract Addresses - Mainnet (Arbitrum One)
# ------------------------------------------------
VITE_MAINNET_MOR_TOKEN_ADDRESS=0x1c9491865a1de77c5b6e19d2e6a5f1d7a6f2b25f
VITE_MAINNET_BUILDERS_CONTRACT_ADDRESS=0xC0eD68f163d44B6e9985F0041fDf6f67c6BCFF3f
VITE_MAINNET_FEE_CONFIG_ADDRESS=
VITE_MAINNET_BUILDERS_TREASURY_ADDRESS=

# Contract Addresses - Testnet (Arbitrum Sepolia)
# ------------------------------------------------
VITE_TESTNET_MOR_TOKEN_ADDRESS=0x34a285A1B1C166420Df5b6630132542923B5b27E
VITE_TESTNET_BUILDERS_CONTRACT_ADDRESS=0xF651907Bfc6A67eCAb3E448c6C8200cD13566baA
VITE_TESTNET_FEE_CONFIG_ADDRESS=0xA961F1c0A03aA601a951cf84F93492aE620Bd82A
VITE_TESTNET_BUILDERS_TREASURY_ADDRESS=0x4e766052bdEc519cDe88C732C08835Ca3bA33Daf

# Subnet Configurations
# ------------------------------------------------
# Mainnet Subnet ID (MOR API Access)
VITE_MAINNET_SUBNET_ID=0x69357171d8794841df9985947a3c20c807b56d43

# Testnet Subnet ID
VITE_TESTNET_SUBNET_ID=0xf827e8c0bff69fdcd1f130641f57cc4ada1f1a54f3c9133b14c58d99151a5e4c

# Default Settings
# ------------------------------------------------
# Default to testnet for safety
VITE_DEFAULT_NETWORK=testnet

# Default minimum stake amount (in MOR)
VITE_DEFAULT_STAKE_AMOUNT=0.01

# Feature Flags
# ------------------------------------------------
# Use mock data for development without blockchain
VITE_USE_MOCK_DATA=false

# Demo mode (set to "true" to enable fake transactions for demo purposes)
VITE_DEMO_MODE=false 